{
  "id": "start-deutsche-fallen",
  "version": 1,
  "title": "Deutsche Fallen – aus der Niveau-Probe vom 24.09.2026",
  "items": [
    {
      "id": "s01",
      "de": "Ich will morgen Brot backen.",
      "en": "I want to bake bread tomorrow.",
      "decode": [["I","ich"],["want","will"],["to","zu"],["bake","backen"],["bread","Brot"],["tomorrow.","morgen."]],
      "note": "Deutsches „wollen“ ist want (to). Englisches will heißt „werden“ und macht Zukunft."
    },
    {
      "id": "s02",
      "de": "Ich rufe dich morgen an.",
      "en": "I'll call you tomorrow.",
      "decode": [["I'll","ich-werde"],["call","rufen"],["you","dich"],["tomorrow.","morgen."]],
      "note": "Hier ist will richtig: Es ist eine Zusage für später, kein Wunsch. I'll = I will."
    },
    {
      "id": "s03",
      "de": "Ich denke auf Deutsch.",
      "en": "I think in German.",
      "decode": [["I","ich"],["think","denke"],["in","in"],["German.","Deutsch."]],
      "note": "Sprachen: think in, speak in, write in. Einfache Gegenwart, weil es eine Gewohnheit ist."
    },
    {
      "id": "s04",
      "de": "Wir hatten eine lange Diskussion.",
      "en": "We had a long discussion.",
      "decode": [["We","wir"],["had","hatten"],["a","eine"],["long","lange"],["discussion.","Diskussion."]],
      "note": "discuss ist das Verb, discussion das Nomen. Und Diskussionen sind long, nicht big."
    },
    {
      "id": "s05",
      "de": "Ich muss auf Englisch umschalten.",
      "en": "I have to switch to English.",
      "decode": [["I","ich"],["have","habe"],["to","zu"],["switch","umschalten"],["to","zu"],["English.","Englisch."]],
      "note": "Müssen = have to. „I have switch“ fehlt das to."
    },
    {
      "id": "s06",
      "de": "Die sind unterschiedlich.",
      "en": "They're different.",
      "decode": [["They're","sie-sind"],["different.","unterschiedlich."]],
      "note": "they're = they are (sie sind). there are = es gibt. Klingen fast gleich."
    },
    {
      "id": "s07",
      "de": "Es gibt zwei Möglichkeiten.",
      "en": "There are two options.",
      "decode": [["There","dort"],["are","sind"],["two","zwei"],["options.","Möglichkeiten."]],
      "note": "Das Gegenstück zu they're: there are = es gibt."
    },
    {
      "id": "s08",
      "de": "Ich warte auf den Bus.",
      "en": "I'm waiting for the bus.",
      "decode": [["I'm","ich-bin"],["waiting","wartend"],["for","für"],["the","den"],["bus.","Bus."]],
      "note": "wait for, nicht wait on. Und gerade jetzt: I'm waiting."
    },
    {
      "id": "s09",
      "de": "Das hängt vom Wetter ab.",
      "en": "It depends on the weather.",
      "decode": [["It","es"],["depends","hängt"],["on","auf"],["the","dem"],["weather.","Wetter."]],
      "note": "depend on – nicht of, nicht from."
    },
    {
      "id": "s10",
      "de": "Es kommt darauf an.",
      "en": "It depends.",
      "decode": [["It","es"],["depends.","hängt-ab."]],
      "note": "Nicht „it comes on it“. Die Kurzform reicht völlig."
    },
    {
      "id": "s11",
      "de": "Ich freue mich aufs Wochenende.",
      "en": "I'm looking forward to the weekend.",
      "decode": [["I'm","ich-bin"],["looking","schauend"],["forward","vorwärts"],["to","zu"],["the","dem"],["weekend.","Wochenende."]],
      "note": "Nach look forward to kommt ein Nomen oder -ing: looking forward to seeing you."
    },
    {
      "id": "s12",
      "de": "Ich interessiere mich für Politik.",
      "en": "I'm interested in politics.",
      "decode": [["I'm","ich-bin"],["interested","interessiert"],["in","in"],["politics.","Politik."]],
      "note": "interested in, nicht for. Und politics endet auf -s."
    },
    {
      "id": "s13",
      "de": "Ich habe Angst vor Spinnen.",
      "en": "I'm afraid of spiders.",
      "decode": [["I'm","ich-bin"],["afraid","ängstlich"],["of","von"],["spiders.","Spinnen."]],
      "note": "Angst haben = be afraid (of). Englisch „ist“ Gefühle, statt sie zu „haben“."
    },
    {
      "id": "s14",
      "de": "Ich habe Hunger.",
      "en": "I'm hungry.",
      "decode": [["I'm","ich-bin"],["hungry.","hungrig."]],
      "note": "Wie bei Angst: Hunger, Durst, Recht haben – im Englischen mit be."
    },
    {
      "id": "s15",
      "de": "Du hast recht.",
      "en": "You're right.",
      "decode": [["You're","du-bist"],["right.","richtig."]],
      "note": "Recht haben = be right."
    },
    {
      "id": "s16",
      "de": "Ich bin gut im Kochen.",
      "en": "I'm good at cooking.",
      "decode": [["I'm","ich-bin"],["good","gut"],["at","an"],["cooking.","kochend."]],
      "note": "good at, nicht good in."
    },
    {
      "id": "s17",
      "de": "Ich stimme dir zu.",
      "en": "I agree with you.",
      "decode": [["I","ich"],["agree","stimme-zu"],["with","mit"],["you.","dir."]],
      "note": "agree with (jemandem). Nicht „I am agree“."
    },
    {
      "id": "s18",
      "de": "Das erinnert mich an meine Kindheit.",
      "en": "That reminds me of my childhood.",
      "decode": [["That","das"],["reminds","erinnert"],["me","mich"],["of","von"],["my","meine"],["childhood.","Kindheit."]],
      "note": "remind someone of something – nicht on."
    },
    {
      "id": "s19",
      "de": "Ich wohne seit zehn Jahren hier.",
      "en": "I've lived here for ten years.",
      "decode": [["I've","ich-habe"],["lived","gewohnt"],["here","hier"],["for","für"],["ten","zehn"],["years.","Jahre."]],
      "note": "Seit + Zeitraum = for, und die Zeitform ist Present Perfect, nicht „I live here since“."
    },
    {
      "id": "s20",
      "de": "Ich habe ihn gestern gesehen.",
      "en": "I saw him yesterday.",
      "decode": [["I","ich"],["saw","sah"],["him","ihn"],["yesterday.","gestern."]],
      "note": "Mit gestern, letzte Woche, 2019: einfache Vergangenheit. Nicht „I have seen him yesterday“."
    },
    {
      "id": "s21",
      "de": "Ich habe einen Fehler gemacht.",
      "en": "I made a mistake.",
      "decode": [["I","ich"],["made","machte"],["a","einen"],["mistake.","Fehler."]],
      "note": "make a mistake. Fehler wird gemacht (make), nicht getan (do)."
    },
    {
      "id": "s22",
      "de": "Ich muss eine Entscheidung treffen.",
      "en": "I have to make a decision.",
      "decode": [["I","ich"],["have","habe"],["to","zu"],["make","machen"],["a","eine"],["decision.","Entscheidung."]],
      "note": "Entscheidungen werden gemacht, nicht getroffen: make a decision."
    },
    {
      "id": "s23",
      "de": "Lass uns eine Pause machen.",
      "en": "Let's take a break.",
      "decode": [["Let's","lass-uns"],["take","nehmen"],["a","eine"],["break.","Pause."]],
      "note": "Pausen werden genommen: take a break."
    },
    {
      "id": "s24",
      "de": "Du musst nicht kommen.",
      "en": "You don't have to come.",
      "decode": [["You","du"],["don't","tust-nicht"],["have","haben"],["to","zu"],["come.","kommen."]],
      "note": "Achtung: you mustn't come heißt „du darfst nicht kommen“. Nicht müssen = don't have to."
    },
    {
      "id": "s25",
      "de": "Ich bekomme morgen ein Paket.",
      "en": "I'm getting a parcel tomorrow.",
      "decode": [["I'm","ich-bin"],["getting","bekommend"],["a","ein"],["parcel","Paket"],["tomorrow.","morgen."]],
      "note": "bekommen = get. become heißt „werden“."
    },
    {
      "id": "s26",
      "de": "Ich kümmere mich darum.",
      "en": "I'll take care of it.",
      "decode": [["I'll","ich-werde"],["take","nehmen"],["care","Sorge"],["of","von"],["it.","es."]],
      "note": "take care of something. Zusage für gleich, daher I'll."
    },
    {
      "id": "s27",
      "de": "Wie sagt man das auf Englisch?",
      "en": "How do you say that in English?",
      "decode": [["How","wie"],["do","tust"],["you","du"],["say","sagen"],["that","das"],["in","in"],["English?","Englisch?"]],
      "note": "Das allgemeine „man“ ist im Englischen oft you."
    },
    {
      "id": "s28",
      "de": "Also komme ich morgen.",
      "en": "So I'll come tomorrow.",
      "decode": [["So","so"],["I'll","ich-werde"],["come","kommen"],["tomorrow.","morgen."]],
      "note": "Deutsches „also“ ist so. Englisches also heißt „auch“."
    },
    {
      "id": "s29",
      "de": "Sie hat sich erkältet.",
      "en": "She's caught a cold.",
      "decode": [["She's","sie-hat"],["caught","gefangen"],["a","eine"],["cold.","Kälte."]],
      "note": "Erkältungen fängt man sich: catch a cold."
    },
    {
      "id": "s30",
      "de": "Mein Handy ist leer.",
      "en": "My phone is dead.",
      "decode": [["My","mein"],["phone","Telefon"],["is","ist"],["dead.","tot."]],
      "note": "Handy ist kein englisches Wort für Telefon. Und leere Akkus sind dead."
    }
  ]
}
